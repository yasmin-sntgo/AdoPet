<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/cream">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:background="@color/white" app:navigationIcon="@drawable/abc_ic_ab_back_material" app:title="Filtrar animais" app:titleTextColor="@color/ink" app:navigationIconTint="@color/ink" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Encontre o pet ideal para você" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/ink" android:paddingBottom="20dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Espécie" android:textStyle="bold" android:textColor="@color/ink" />
        <Spinner android:id="@+id/spSpecies" android:layout_width="match_parent" android:layout_height="56dp" android:background="@android:drawable/editbox_background" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Porte" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="16dp" />
        <Spinner android:id="@+id/spSize" android:layout_width="match_parent" android:layout_height="56dp" android:background="@android:drawable/editbox_background" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sexo" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="16dp" />
        <Spinner android:id="@+id/spSex" android:layout_width="match_parent" android:layout_height="56dp" android:background="@android:drawable/editbox_background" />
        <CheckBox android:id="@+id/checkOnlyAvailable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mostrar somente disponíveis" android:checked="true" android:textColor="@color/ink" android:layout_marginTop="14dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnApply" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="Aplicar filtros" app:backgroundTint="@color/green_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnClear" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Limpar filtros" android:textColor="@color/green_primary" />
    </LinearLayout>
</LinearLayout>
