<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/cream">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:background="@color/white" app:navigationIcon="@drawable/abc_ic_ab_back_material" app:title="Cadastrar animal" app:titleTextColor="@color/ink" app:navigationIconTint="@color/ink" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Informações do pet" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/ink" android:paddingBottom="12dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nome *"><com.google.android.material.textfield.TextInputEditText android:id="@+id/inputName" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
            <Spinner android:id="@+id/spSpecies" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@android:drawable/editbox_background" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutOtherSpecies" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Qual tipo de animal? *" android:visibility="gone" android:layout_marginTop="10dp"><com.google.android.material.textfield.TextInputEditText android:id="@+id/inputOtherSpecies" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLength="50" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Idade aproximada (anos) *" android:layout_marginTop="10dp"><com.google.android.material.textfield.TextInputEditText android:id="@+id/inputAge" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" /></com.google.android.material.textfield.TextInputLayout>
            <Spinner android:id="@+id/spSize" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@android:drawable/editbox_background" />
            <Spinner android:id="@+id/spSex" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@android:drawable/editbox_background" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Localização *" android:layout_marginTop="10dp"><com.google.android.material.textfield.TextInputEditText android:id="@+id/inputLocation" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Personalidade e história *" android:layout_marginTop="10dp"><com.google.android.material.textfield.TextInputEditText android:id="@+id/inputDescription" android:layout_width="match_parent" android:layout_height="110dp" android:gravity="top" /></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Saúde e cuidados" android:layout_marginTop="10dp"><com.google.android.material.textfield.TextInputEditText android:id="@+id/inputHealth" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ONG ou protetor responsável *" android:layout_marginTop="10dp"><com.google.android.material.textfield.TextInputEditText android:id="@+id/inputGuardian" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
            <CheckBox android:id="@+id/checkAdopted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Este animal já foi adotado" android:textColor="@color/ink" android:layout_marginTop="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="Salvar animal" app:backgroundTint="@color/green_primary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
